# Consilium local configuration. # pragma: allowlist secret
# Copy to .env and fill secrets there. This file has no real values.
# Defaults live in consilium.config. Research prototype. Not for clinical use. # pragma: allowlist secret

# Postgres URL. Docker Compose (docker-compose.yml) publishes
# postgresql://consilium:consilium@localhost:5432/consilium # pragma: allowlist secret
# Settings default when this is empty: postgresql://localhost:5432/consilium # pragma: allowlist secret
DATABASE_URL=

# local or uc_volume
STORAGE_BACKEND=

# Path, or a /Volumes/... root, for slides and thumbnail packs.
STORAGE_ROOT=

# On-disk cache of slides fetched from a Volume.
SLIDE_CACHE_DIR=
SLIDE_CACHE_MAX_GB=

# pgvector or lakebase
SEARCH_BACKEND=

# anthropic or databricks
LLM_PROVIDER=

# Secret. Leave empty until the consult agent is used.
ANTHROPIC_API_KEY=

# Model id for the consult agent.
ANTHROPIC_MODEL=

# Secret. Gated model weights. TCGA slides and reports need no token.
HF_TOKEN=

# Host and secret for Volume access from outside Databricks.
# A trailing slash on the host is stripped. Never commit a token.
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Managed volume root, for example /Volumes/main/consilium/raw.  # pragma: allowlist secret
DATABRICKS_VOLUME_ROOT=

# Optional SQL warehouse and Unity Catalog names for pipeline reconcile.
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=

# Built SvelteKit directory. Empty uses typescript/apps/web/build when index.html
# is already there, and skips static serving otherwise. The Databricks App sets
# this to static_web.
WEB_BUILD_DIR=

# Consult-turn tracing. Off by default, so a laptop without Databricks
# credentials makes no MLflow or Databricks calls. true logs each turn.
MLFLOW_TRACING_ENABLED=

# Experiment path. Default /Shared/consilium-consult. # pragma: allowlist secret
MLFLOW_EXPERIMENT_NAME=

# databricks (the default when tracing is on) or a local directory for the file store.
MLFLOW_TRACKING_URI=
