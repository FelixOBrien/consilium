{
  "name": "typescript",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,svelte,js,css,md}\"",
    "check-types": "turbo run check-types",
    "typecheck": "turbo run typecheck",
    "test": "bun test --pass-with-no-tests"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.11.11",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.13"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
